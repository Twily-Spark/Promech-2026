void scan_i2c_bus() {
    pc.printf("\r\n[SCAN] I2C Bus (PB_9=SDA, PB_8=SCL)...\r\n");
    pc.printf("Addr: ");
    for (int addr = 0x08; addr <= 0x77; addr++) {
        char dummy = 0;
        if (i2c.write(addr << 1, &dummy, 0) == 0) {
            pc.printf("0x%02X ", addr);
        }
    }
    pc.printf("\r\n[SCAN] Done.\r\n\r\n");
}

