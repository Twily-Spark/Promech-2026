        thread_sleep_for(10);
    }
    
    motors_stop();
    pc.printf("  [TIMEOUT] Turn incomplete\r\n");
    return false;
}
void can10_send_vel_custom(float vel, float kp_gain, int ff_value) {
    if(vel < -30.f) vel = -30.f; 
    if(vel > 30.f) vel = 30.f;
    
    int p = 1;  // Enable
    int v = (int)((vel + 30.f) * 4095.f / 60.f);  // Scale vel to 12-bit
    int kdi = (int)(kp_gain * 4095.f / 5.f);       // Scale kp to 12-bit
    int ff = ff_value;                              // Feedforward term
    
    tx_msg.data[0] = (p >> 8) & 0xFF;
    tx_msg.data[1] = p & 0xFF;
    tx_msg.data[2] = (v >> 4) & 0xFF;
    tx_msg.data[3] = ((v & 0xF) << 4);
    tx_msg.data[4] = 0;
    tx_msg.data[5] = (kdi >> 4) & 0xFF;
    tx_msg.data[6] = ((kdi & 0xF) << 4) | ((ff >> 8) & 0xF);
    tx_msg.data[7] = ff & 0xFF;
    
    tx_msg.id = CAN_GRIP + 0x100;  // Feedback ID format
    tx_msg.type = CANData;
    tx_msg.format = CANStandard;
    tx_msg.len = 8;
    
    can.write(tx_msg);
    wait_us(100);
}

// High-torque version: uses aggressive gains for climbing
