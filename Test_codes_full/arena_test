bool forest_grab_box(int direction) {
    pc.printf("[FOREST] GRAB BOX dir=%+d\r\n", direction);
    lprintf(0,0,"GRAB BOX %s     ", (direction>0)?"UP":"DN");
    
    const float GRAB_DISTANCE_M = 0.45f;  // Distance to extend into box
    const float RETRACT_DISTANCE_M = 0.45f;
    const uint32_t GRAB_SETTLE_MS = 400;   // Time for mechanical engagement
    const int MAX_RETRIES = 2;
    
    bool success = false;
    
    for(int retry=0; retry<MAX_RETRIES && !success; retry++) {
        if(retry > 0) {
            pc.printf("[GRAB] Retry %d/%d\r\n", retry+1, MAX_RETRIES);
            lprintf(1,0,"RETRY %d...     ", retry+1);
            // Retract before retry
            move_can10_metres(-0.15f, BOX_GRIP_SPD);
            thread_sleep_for(200);
        }
        
        // ── STEP 1: Set gripper direction (cyl_dir) ────────────────────
        // direction: +1 = UP grab, -1 = DOWN grab
        lprintf(1,0,"SET DIR %s...   ", (direction>0)?"UP":"DN");
        if(direction > 0) {
            cyl4_up();    // cyl_dir = 1
        } else {
            cyl4_down();  // cyl_dir = 0
        }
        thread_sleep_for(300);  // Let cylinder settle
        pc.printf("  [DIR] cyl_dir=%d\r\n", cyl_dir.read());
        
        // ── STEP 2: Extend CAN10 to grab position (encoder-based) ─────
        lprintf(1,0,"EXTEND...       ");
        pc.printf("  [GRAB] Extending %.2fm\r\n", GRAB_DISTANCE_M);
        
        int32_t enc_before_extend = enc_grip;
        bool extended = move_can10_metres(GRAB_DISTANCE_M * (float)direction, BOX_GRIP_SPD);
        
        if(!extended) {
            pc.printf("  [WARN] Extend incomplete\r\n");
        }
        
        int32_t enc_after_extend = enc_grip;
        pc.printf("  [ENC] Moved %ld ticks\r\n", (long)(enc_after_extend - enc_before_extend));
        lprintf(1,0,"EXTENDED OK     ");
        thread_sleep_for(150);
        
        // ── STEP 3: Engage holding torque DURING grab ─────────────────
        lprintf(1,0,"HOLD TORQUE...  ");
        can10_active_hold(1.2f);  // High torque to fight gravity
        thread_sleep_for(100);
        
        // ── STEP 4: Settle time for mechanical engagement ─────────────
        lprintf(1,0,"SETTLE...       ");
        thread_sleep_for(GRAB_SETTLE_MS);
        
        // ── STEP 5: Verify grab with stall check ──────────────────────
        // Try small retract; if encoder barely moves, box is grabbed
        int32_t enc_before_test = enc_grip;
        can10_send_vel(-0.3f * (float)direction);  // Small retract attempt
        thread_sleep_for(250);
        can10_send_vel(0.f);
        thread_sleep_for(50);
        int32_t enc_after_test = enc_grip;
        int32_t delta = abs(enc_after_test - enc_before_test);
        
        if(delta < 300) {  // Minimal movement = box grabbed (stall)
            pc.printf("  [✓] Grab confirmed (stall: %ld ticks)\r\n", (long)delta);
            success = true;
        } else {
            pc.printf("  [✗] Grab failed — slipped (moved %ld ticks)\r\n", (long)delta);
            // Release and retry
            cyl4_down();  // Reset direction
            can10_release_hold();
            continue;
        }
        
        // ── STEP 6: Retract with box (encoder-based) ──────────────────
        lprintf(1,0,"RETRACT...      ");
        bool retracted = move_can10_metres(-RETRACT_DISTANCE_M * (float)direction, BOX_GRIP_SPD * 0.7f);
        
        if(!retracted) {
            pc.printf("  [WARN] Retract incomplete\r\n");
        }
        
        // ── STEP 7: Maintain strong hold after retract ────────────────
        can10_active_hold(1.0f);  // Keep high torque
        lprintf(1,0,"BOX SECURED     ");
        pc.printf("[FOREST] BOX GRABBED OK (retry=%d, dir=%d)\r\n", retry, cyl_dir.read());
        thread_sleep_for(200);
    }
    
    if(!success) {
        lprintf(1,0,"GRAB FAILED!    ");
        pc.printf("[ERROR] Box grab failed after %d retries\r\n", MAX_RETRIES);
        cyl4_down();  // Reset direction
        can10_release_hold();
        return false;
    }
    
    return true;
}

void forest_box_action(int block) {
    pc.printf("[BOX] Executing for Block %d\r\n", block);
    
    // Determine direction based on block
    bool is_up_group   = (block == 1 || block == 2 || block == 3 || 
                          block == 5 || block == 6 || block == 7 || 
                          block == 8 || block == 11);
    bool is_down_group = (block == 4 || block == 9 || block == 10 || block == 12);
    
    int direction = is_up_group ? 1 : -1;
    
    if(is_up_group) {
        pc.printf("[BOX] UP SEQUENCE (dir=+1)\r\n");
        
        // 1. Set direction UP
        lprintf(1,0,"CYL4 UP         ");
        cyl4_up();  // cyl_dir = 1
        thread_sleep_for(500);
        
        // 2. Extend to box (encoder-based)
        lprintf(1,0,"CAN10 EXT +45cm ");
        move_can10_metres(0.45f, BOX_GRIP_SPD);
        lprintf(1,0,"OK              ");
        thread_sleep_for(200);
        
        // 3. Engage hold torque
        can10_active_hold(1.2f);
        thread_sleep_for(150);
        
        // 4. Retract with box
        lprintf(1,0,"CAN10 RET -45cm ");
        move_can10_metres(-0.45f, BOX_GRIP_SPD * 0.7f);
        lprintf(1,0,"OK              ");
        
        // 5. Reset direction
        lprintf(1,0,"CYL4 DOWN       ");
        cyl4_down();  // cyl_dir = 0
        thread_sleep_for(500);
        
        pc.printf("[BOX] BOX HELD (UP)\r\n");
        
    } else if(is_down_group) {
        pc.printf("[BOX] DOWN SEQUENCE (dir=-1)\r\n");
        
        // 1. Set direction DOWN
        lprintf(1,0,"CYL4 DOWN       ");
        cyl4_down();  // cyl_dir = 0
        thread_sleep_for(500);
        
        // 2. Extend to box (encoder-based)
        lprintf(1,0,"CAN10 EXT +45cm ");
        move_can10_metres(-0.45f, BOX_GRIP_SPD);  // Negative for DOWN direction
        lprintf(1,0,"OK              ");
        thread_sleep_for(200);
        
        // 3. Engage hold torque
        can10_active_hold(1.2f);
        thread_sleep_for(150);
        
        // 4. Retract with box
        lprintf(1,0,"CAN10 RET -45cm ");
        move_can10_metres(0.45f, BOX_GRIP_SPD * 0.7f);  // Positive to retract
        lprintf(1,0,"OK              ");
        
        // 5. Reset direction
        lprintf(1,0,"CYL4 UP         ");
        cyl4_up();  // cyl_dir = 1
        thread_sleep_for(500);
        
        pc.printf("[BOX] BOX HELD (DOWN)\r\n");
    }
    
    // Keep holding torque active
    can10_active_hold(0.8f);
}

