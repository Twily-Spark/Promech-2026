float read_cm(AnalogIn& s, float K, float off) {
    float v = (float)s.read_u16()/65535.f*3.3f;
    if(v<0.35f) return 999.f; if(v>2.90f) return 10.f;
    float d = K/(v-off);
    if(d<10.f) d=10.f; if(d>150.f) return 999.f;
    return d;
}
