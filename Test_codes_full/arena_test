void can_send_vel(uint32_t id, float vel, bool high_torque = false) {
    // Clamp velocity
    if(vel < -30.f) vel = -30.f; 
    if(vel > 30.f) vel = 30.f;
    
    // Select parameters based on torque mode
    float kdi_gain = high_torque ? CLIMB_KDI_GAIN : 1.0f;
    int ff_term    = high_torque ? CLIMB_FF_CURRENT : 2048;
    float max_vel  = high_torque ? CLIMB_MAX_VEL : 30.f;
    
    // Apply velocity limit for high-torque mode
    if(high_torque && fabsf(vel) > max_vel) {
        vel = (vel > 0) ? max_vel : -max_vel;
    }
    
    // Encode command (same protocol, different parameters)
    int p = 1;  // Enable flag
    int v = (int)((vel + 30.f) * 4095.f / 60.f);  // Velocity: -30..+30 → 0..4095
    int kdi = (int)(kdi_gain * 4095.f / 5.f);     // PID gain scaled to 12-bit
    
    tx_msg.data[0] = (p >> 8) & 0xFF; 
    tx_msg.data[1] = p & 0xFF;
    tx_msg.data[2] = (v >> 4) & 0xFF; 
    tx_msg.data[3] = ((v & 0xF) << 4);
    tx_msg.data[4] = 0;
    tx_msg.data[5] = (kdi >> 4) & 0xFF;
    tx_msg.data[6] = ((kdi & 0xF) << 4) | ((ff_term >> 8) & 0xF);
    tx_msg.data[7] = ff_term & 0xFF;
    
    tx_msg.id = id; 
    tx_msg.type = CANData; 
    tx_msg.format = CANStandard; 
    tx_msg.len = 8;
    
    can.write(tx_msg); 
    wait_us(100);
}

// Convenience wrapper for high-torque commands (wheel motors only)
void can_send_vel_climb(uint32_t id, float vel) {
    // Only apply high-torque to wheel motors (IDs 11-14)
    if(id >= CAN_FL && id <= CAN_FR) {
        can_send_vel(id, vel, true);  // high_torque = true
    } else {
        can_send_vel(id, vel, false); // normal mode for other motors
    }
}

// Update can10_send_vel to use base function (no high-torque for grip motor)
void can10_send_vel(float vel) { 
    can_send_vel(CAN_GRIP, vel, false);  // Grip motor always normal mode
}
void can10_active_hold(float hold_current = 1.0f) {
    if(hold_current < 0.f) hold_current = 0.f;
    if(hold_current > 2.f) hold_current = 2.f;
    
    static uint32_t last_hold = 0;
    uint32_t now = us_ticker_read() / 1000;
    
    // Send hold command every 30ms (more frequent = better hold)
    if(now - last_hold > 30) {
        // Send velocity command for holding torque
        can10_send_vel(hold_current);
        
        // ALSO send explicit brake-mode frame (some controllers need both)
        CANMessage hold_msg;
        hold_msg.id = CAN_GRIP;  // ✅ Base ID 10, not +0x100
        hold_msg.type = CANData;
        hold_msg.format = CANStandard;
        hold_msg.len = 8;
        
        int p = 1;  // Enable
        int v = (int)((hold_current + 30.f) * 4095.f / 60.f);
        int kdi = (int)(1.0f * 4095.f / 5.f);
        int ff = 2048;
        
        hold_msg.data[0] = (p >> 8) & 0xFF;
        hold_msg.data[1] = p & 0xFF;
        hold_msg.data[2] = (v >> 4) & 0xFF;
        hold_msg.data[3] = ((v & 0xF) << 4);
        hold_msg.data[4] = 0;
        hold_msg.data[5] = (kdi >> 4) & 0xFF;
        hold_msg.data[6] = ((kdi & 0xF) << 4) | ((ff >> 8) & 0xF);
        hold_msg.data[7] = ff & 0xFF;
        
        can.write(hold_msg);
        
        last_hold = now;
    }
}

void can10_release_hold() {
    can10_send_vel(0.f);
}

