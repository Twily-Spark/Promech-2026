void linear_forward(float spd) {
    float c = 0.f;
    if(enc_right > enc_left) {
        c = (float)(enc_right - enc_left) / CORR_GAIN / 100.f;
        if(c > CORR_CAP) c = CORR_CAP;
        vel_r = spd - c;  vel_l = spd + c;
    } else if(enc_left > enc_right) {
        c = (float)(enc_left - enc_right) / CORR_GAIN / 100.f;
        if(c > CORR_CAP) c = CORR_CAP;
        vel_l = spd - c;  vel_r = spd + c;
    } else { vel_l = vel_r = spd; }
    if(vel_l < 0.1f) vel_l = 0.1f;  if(vel_l > 30.f) vel_l = 30.f;
    if(vel_r < 0.1f) vel_r = 0.1f;  if(vel_r > 30.f) vel_r = 30.f;
}

// Enhanced forward drive with optional high-torque mode
void drive_fwd_corrected(bool high_torque = false) {
    // Apply correction logic first
    float c = 0.f;
    if(enc_right > enc_left) {
        c = (float)(enc_right - enc_left) / CORR_GAIN / 100.f;
        if(c > CORR_CAP) c = CORR_CAP;
        vel_r = APPROACH_SPD - c;  vel_l = APPROACH_SPD + c;
    } else if(enc_left > enc_right) {
        c = (float)(enc_left - enc_right) / CORR_GAIN / 100.f;
        if(c > CORR_CAP) c = CORR_CAP;
        vel_l = APPROACH_SPD - c;  vel_r = APPROACH_SPD + c;
    }
    
    // Clamp velocities
    if(vel_l < 0.1f) vel_l = 0.1f;  if(vel_l > 30.f) vel_l = 30.f;
    if(vel_r < 0.1f) vel_r = 0.1f;  if(vel_r > 30.f) vel_r = 30.f;
    
    // Send commands with torque mode
    if(high_torque && CLIMB_TORQUE_MODE) {
        // Use climb-specific send function
        can_send_vel_climb(CAN_FL, -vel_l); wait_us(100);
        can_send_vel_climb(CAN_BL, -vel_l); wait_us(100);
        can_send_vel_climb(CAN_BR,  vel_r); wait_us(100);
        can_send_vel_climb(CAN_FR,  vel_r); wait_us(100);
    } else {
        // Use standard send function
        can_send_vel(CAN_FL, -vel_l, false); wait_us(100);
        can_send_vel(CAN_BL, -vel_l, false); wait_us(100);
        can_send_vel(CAN_BR,  vel_r, false); wait_us(100);
        can_send_vel(CAN_FR,  vel_r, false); wait_us(100);
    }
}
